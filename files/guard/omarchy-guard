#!/bin/bash
# omarchy-zero update guard. Sits ahead of $OMARCHY_PATH/bin on PATH and outside
# the checkout, so a git pull of Omarchy cannot remove it. Every command linked
# here updates Omarchy or rewrites something this install set up by hand (boot,
# login, bar, pacman). The safe update path is in README, "Updating".
name=$(basename "$0")
real="${OMARCHY_PATH:-$HOME/.local/share/omarchy}/bin/$name"
if [[ ${OMARCHY_GUEST_ALLOW:-} == 1 ]]; then exec "$real" "$@"; fi
[[ $name == omarchy-migrate && ${1:-} == --pending ]] && exit 1
msg="$name is blocked on this install (it would break it). See README, \"Updating\"; to force: OMARCHY_GUEST_ALLOW=1 $name"
echo "$msg" >&2
command -v omarchy-notification-send >/dev/null && omarchy-notification-send -u critical "Blocked" "$name - see omarchy-zero README" >/dev/null 2>&1 || true
exit 1
